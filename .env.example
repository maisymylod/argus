# Copy to .env and fill in. NEVER commit a real .env (it is gitignored).

# Anthropic / Claude (agent uses these, wired in Phase 3)
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_HEAVY=claude-opus-4-8

# Postgres + pgvector
POSTGRES_USER=argus
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=argus
DATABASE_URL=postgresql://argus:change-me-locally@db:5432/argus

# Public earth-observation STAC source (no auth required for browse)
STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1

# Service ports (host side)
GATEWAY_PORT=8000
WEB_PORT=8080

# Logging
LOG_LEVEL=INFO
